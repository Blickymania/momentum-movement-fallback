{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momentum-movement-gateway-lease",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY_LEASE_COORDINATOR",
        "class_name": "GatewayLeaseCoordinator"
      },
      {
        "name": "COACHING_IDEMPOTENCY_STORE",
        "class_name": "CoachingInteractionIdempotency"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewayLeaseCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CoachingInteractionIdempotency"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
