# Example only. Do not deploy until a no-card Cloudflare Free account and D1 database exist.
# Replace the D1 database_id after provisioning. This file contains no secrets.
name = "momentum-movement-discord-manager"
main = "src/worker.mjs"
compatibility_date = "2026-11-13"
workers_dev = true

[vars]
AUTHORIZED_GUILD_ID = "1565048205970767992"
APPLICATION_ID = "1565304619838742598"
SOCIAL_TIKTOK_URL = ""
MCP_OAUTH_ENABLED = "false"
GATEWAY_COORDINATOR_ENABLED = "false"
BOT005_PROFILE_MODAL_ENABLED = "false"
BOT005_PING_ENABLED = "false"
BOT005_STATUS_ENABLED = "false"
BOT005_RULES_ENABLED = "false"
BOT005_STATSSTATUS_ENABLED = "false"
BOT005_EVENTS_ENABLED = "false"
BOT005_MEMBER_ENABLED = "false"
BOT005_SERVER_ENABLED = "false"
BOT005_HELP_ENABLED = "false"
BOT005_TIKTOK_ENABLED = "false"

[[durable_objects.bindings]]
name = "GATEWAY_COORDINATOR"
class_name = "GatewayCoordinatorDurableObject"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["GatewayCoordinatorDurableObject"]

[[d1_databases]]
binding = "OAUTH_DB"
database_name = "momentum-movement-oauth"
database_id = "REPLACE_AFTER_NO_CARD_D1_PROVISIONING"
migrations_dir = "migrations"

# No [triggers] / crons are configured.
# Add secrets only through wrangler secret put after the owner authorizes the
# no-card Free account and each required secret has been supplied securely.
# Before any isolated Gateway test, configure these non-secret vars securely:
# GATEWAY_CLIENT_DEFINITIONS = JSON array of verified client IDs, guild IDs,
# application IDs, intents, tokenRef names and explicit enabled flags.
# GATEWAY_HANDLER_MANIFEST = JSON with the same guild/application IDs,
# liveChannelId, one livePublisher ("none", "live-events-listener", or
# "live-now-v2"), and the explicit enabledHandlers array. The isolated
# "bot005-profile-modal" requires BOT005_PROFILE_MODAL_ENABLED=true;
# "bot005-ping" requires BOT005_PING_ENABLED=true; "bot005-status" requires
# BOT005_STATUS_ENABLED=true; "bot005-rules" requires BOT005_RULES_ENABLED=true.
# "bot005-statsstatus" requires BOT005_STATSSTATUS_ENABLED=true; "bot005-events" requires
# BOT005_EVENTS_ENABLED=true; "bot005-member" requires BOT005_MEMBER_ENABLED=true.
# "bot005-server" requires BOT005_SERVER_ENABLED=true; "bot005-help" requires
# BOT005_HELP_ENABLED=true.
# Set SOCIAL_TIKTOK_URL only to the official HTTPS profile URL; it is not a secret.\n# Keep all ten flags disabled until the complete
# feature and restore gates pass. Do not enable general "bot005" while only
# these isolated features are available.
#
# Required secrets for isolated Gateway/OAuth tests (secret bindings only):
# DISCORD_BOT_TOKEN (one per verified tokenRef name),
# GATEWAY_INTERACTION_ENCRYPTION_KEY (64 hex chars / exactly 32 random bytes),
# BOT005_PROFILE_ENCRYPTION_KEY (64 hex chars / exactly 32 random bytes, separate from the interaction key; profile feature only),
# MCP_INTERNAL_BEARER_TOKEN (at least 32 characters),
# DISCORD_OAUTH_CLIENT_ID and DISCORD_OAUTH_CLIENT_SECRET.
#
# Do NOT set GATEWAY_COORDINATOR_ENABLED=true until every original handler has
# been ported, interaction ACK is immediate and idempotent, a matching
# application/token identity check passes, and the 24-hour Free quota soak
# passes. Never commit any secret values.
