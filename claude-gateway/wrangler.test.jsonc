{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-claude-gateway-write-tests",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WRITE_PROPOSAL_STORE", "class_name": "WriteProposalStore" }
    ]
  },
  "migrations": [
    { "tag": "test-v1", "new_sqlite_classes": ["WriteProposalStore"] }
  ]
}
