{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-claude-auth-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "OAUTH_ISSUER_URL": "",
    "MCP_RESOURCE_URL": "",
    "DISCORD_CLIENT_ID": "",
    "DISCORD_REDIRECT_URI": "",
    "GUILD_ID_EMPRESS": "",
    "GUILD_ID_BLICKYMANIA": "",
    "GUILD_ID_BESTYOUEVAHAD": "",
    "GUILD_ID_RED_KOCAINE": "",
    "GUILD_ID_DAWN_DOTTA": ""
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": ""
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_ONE_TIME_STORE",
        "class_name": "OAuthOneTimeStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OAuthOneTimeStore"
      ]
    }
  ],
  "services": [
    {
      "binding": "GATEWAY_SERVER",
      "service": "discord-claude-gateway-staging"
    }
  ]
}
