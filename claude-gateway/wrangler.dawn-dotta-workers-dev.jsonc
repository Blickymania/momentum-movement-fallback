{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-claude-gateway-dawn-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": ["OWNER_APPROVAL_INTERNAL_SECRET", "MANAGER_WRITE_SECRET_DAWN_DOTTA"]
  },
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "discord-claude-auth-dawn-staging"
    },
    {
      "binding": "MANAGER_DAWN_DOTTA",
      "service": "manager-dawn-dotta-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WRITE_PROPOSAL_STORE",
        "class_name": "WriteProposalStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WriteProposalStore"
      ]
    }
  ]
}
